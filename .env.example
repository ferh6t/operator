# Copy to .env and fill in. .env is git-ignored.

# SSH keys as a YAML list: fingerprints or numeric IDs from
# DigitalOcean > Settings > Security, or `doctl compute ssh-key list`
DO_SSH_KEYS=["aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"]

# DigitalOcean API token (API > Tokens)
DO_TOKEN=dop_v1_replace_me
